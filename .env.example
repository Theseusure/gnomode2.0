# Public RPC by default. Upgrade to dRPC or QuickNode when rate-limited.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional Blockscout Pro API key (api.blockscout.com)
BLOCKSCOUT_API_KEY=

# Default early-buyer market-cap threshold (USD)
MCAP_THRESHOLD=15000

# Block range per eth_getLogs request (lower = safer on public RPC)
LOG_CHUNK_SIZE=100000
RPC_CONCURRENCY=24

# Optional: funded EOА (≥0.05 ETH) for honeypot buy→sell eth_call simulation.
# If empty, auto-picked from WETH holders via Blockscout.
HONEYPOT_SIM_WHALE=

# Host / port for API
HOST=0.0.0.0
PORT=8000
